# ── LLM provider ─────────────────────────────────────────────────────────────
# litellm handles provider routing — change the model string, swap the key.
# No code changes needed when switching providers.
#
# OpenAI
# LITELLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Google AI Studio (Gemini)
LITELLM_MODEL=gemini/gemini-2.0-flash
GEMINI_API_KEY=...

# Anthropic
# LITELLM_MODEL=claude-3-haiku-20240307
# ANTHROPIC_API_KEY=sk-ant-...

# Local (no key needed)
# LITELLM_MODEL=ollama/llama3

# ── Tuning ────────────────────────────────────────────────────────────────────
# Number of instructor retries on structured output validation failure.
# Increase to 5 when using Gemini (occasionally needs an extra retry).
QA_LLM_RETRIES=3

# ── Cache ─────────────────────────────────────────────────────────────────────
# Parsed questionnaire results are cached here. Same file = $0 on repeat runs.
QA_CACHE_DIR=.cache
